{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push)",
            "Bash(git push *)"
        ],
        "deny": [
            "Bash(git branch *)",
            "Bash(git checkout *)",
            "Bash(git switch *)",
            "Bash(git merge *)",
            "Bash(git rebase)",
            "Bash(git rebase *)",
            "Bash(git reset)",
            "Bash(git reset *)",
            "Bash(git restore *)",
            "Bash(git stash)",
            "Bash(git stash *)",
            "Bash(git tag *)",
            "Bash(git cherry-pick *)",
            "Bash(git revert *)",
            "Bash(git clean *)",
            "Bash(git am *)",
            "Bash(docker compose down -v*)",
            "Bash(docker compose down --volumes*)",
            "Bash(docker-compose down -v*)",
            "Bash(docker volume rm *)",
            "Bash(docker volume prune*)",
            "Bash(docker system prune*)",
            "Bash(n8n export:credentials*)",
            "Bash(docker * export:credentials*)",
            "Read(./.env)",
            "Read(./.env.*.local)",
            "Read(./docs/archive/**)"
        ]
    },
    "enabledMcpjsonServers": ["context7", "playwright", "n8n-mcp"]
}
