      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO chatbot_chat_reply_state (chat_id, last_reply_at) VALUES ($1, now())\nON CONFLICT (chat_id) DO UPDATE SET last_reply_at = now()\nWHERE chatbot_chat_reply_state.last_reply_at <= now() - make_interval(secs => $2::double precision)\nRETURNING chat_id;",
        "options": {
          "queryReplacement": "={{ [ $('When called by orchestrator').item.json.message.chatId, $('When called by orchestrator').item.json.config.perChatMinIntervalSeconds ] }}"
        }
      },
