    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Normalize WAHA message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        -20
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? {};\nconst payload = body.payload ?? {};\nconst fromMe = payload.fromMe === true;\nconst chatId = fromMe ? payload.to : payload.from;\nconst TYPES = {\n  conversation: 'text', extendedTextMessage: 'text', imageMessage: 'image',\n  audioMessage: 'audio', videoMessage: 'video', ptvMessage: 'video',\n  stickerMessage: 'sticker', documentMessage: 'document',\n  documentWithCaptionMessage: 'document', locationMessage: 'location',\n  liveLocationMessage: 'location', contactMessage: 'contact',\n  contactsArrayMessage: 'contact', reactionMessage: 'reaction',\n};\nlet raw = payload._data?.message;\nfor (const w of ['ephemeralMessage', 'viewOnceMessage', 'viewOnceMessageV2', 'editedMessage']) raw = raw?.[w]?.message ?? raw;\nconst key = raw && typeof raw === 'object' ? Object.keys(raw).find((k) => !['messageContextInfo', 'senderKeyDistributionMessage'].includes(k)) : undefined;\nif (key === 'protocolMessage') return { json: { accepted: false, reason: 'not-a-user-message' } };\nconst text = String(payload.body ?? '').trim();\nlet type = 'unknown';\nif (key) type = key.startsWith('pollCreationMessage') ? 'poll' : (TYPES[key] ?? 'unknown');\nelse if (!payload.hasMedia && text) type = 'text';\nif (type === 'text' && !text) type = 'unknown';\nconst message = {\n  messageId: payload.id, session: body.session, chatId,\n  senderId: payload.participant ?? payload.from, fromMe, type,\n  text: type === 'text' ? text : '', timestamp: payload.timestamp,\n  isGroup: String(chatId ?? '').endsWith('@g.us'),\n  isDirect: ['@c.us', '@lid', '@s.whatsapp.net'].some((s) => String(chatId ?? '').endsWith(s)),\n};\nreturn { json: { accepted: true, message } };"
      }
    },
