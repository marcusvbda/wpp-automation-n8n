      "typeVersion": 1,
      "position": [
        -20,
        -440
      ],
      "parameters": {
        "content": "## Contract\nInput: `{ config, chatId, text }` (config uses businessRules, llmModel, llmTemperature, llmMaxOutputTokens, memoryWindow).\nOutput: `{ ok: true, reply }` or `{ ok: false, error }`. Never throws for LLM errors.\nMemory is keyed by chatId in table `chatbot_chat_histories` and written only on success (n8n saves the turn after the agent succeeds). No retries.",
        "height": 240,
        "width": 1220,
        "color": 5
      }
