        "width": 720,
        "color": 7
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000012",
      "name": "Sticky 2 Result",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        840,
        -200
      ],
      "parameters": {
        "content": "## 2 · Result\nSuccess returns `{ ok: true, reply }`. An empty reply or an LLM error returns `{ ok: false, error }`; the error carries the provider's error message only (no user text is added).",
        "height": 600,
        "width": 360,
        "color": 4
      }
    },
    {
      "id": "b2000000-0000-4000-8000-000000000013",
      "name": "Sticky Contract",
