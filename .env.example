# Copy to .env and fill in. Never commit .env.
# Image tags must be pinned to fixed versions, never `latest`.

# WAHA
# pinned tag, never `latest`
WAHA_TAG=
# host port for the dashboard/API, e.g. 3100
WAHA_HOST_PORT=
# e.g. admin
WAHA_DASHBOARD_USER=
WAHA_DASHBOARD_PASSWORD=
# openssl rand -hex 32
WAHA_API_KEY=
# openssl rand -hex 32 — header WAHA sends to the n8n webhook (X-Waha-Webhook-Secret)
WAHA_WEBHOOK_SECRET=

# n8n
# pinned tag, never `latest`
N8N_TAG=
# openssl rand -hex 32 — generate once, store in the password manager
N8N_ENCRYPTION_KEY=
# IANA zone, e.g. America/Sao_Paulo
TZ=

# Postgres
# pinned tag, e.g. 17.11-alpine
POSTGRES_TAG=
# openssl rand -hex 24 (superuser; init scripts run only on an empty data dir)
POSTGRES_PASSWORD=
# openssl rand -hex 24 (role n8n)
N8N_DB_PASSWORD=
# openssl rand -hex 24 (role waha)
WAHA_DB_PASSWORD=

# Redis
# pinned tag, e.g. 8.10.2-alpine
REDIS_TAG=
# openssl rand -hex 24
REDIS_PASSWORD=

# n8n queue mode
# optional, parallel jobs per worker (default 10)
N8N_WORKER_CONCURRENCY=

# n8n Registered Community license (free): unlocks Debug in editor, folders, custom execution data.
# Request it in n8n: Settings > Usage and plan > Unlock (key arrives by email). Optional.
N8N_LICENSE_ACTIVATION_KEY=

# n8n MCP (used by scripts/n8n-mcp.sh)
# created by the owner in n8n: Settings > n8n API
N8N_API_KEY=
