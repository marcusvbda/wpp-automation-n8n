        "jsCode": "// Monta o texto do aviso ao grupo de atendimento (função pura, sem rede)\nconst h = $('7.3 Preparar handoff').first().json;\nconst cfg = $('CONFIG').first().json;\nconst tel = String(h.telefone ?? '').replace(/\\D/g, '');\n// 55 + DDD + 8 ou 9 dígitos vira +55 DD NNNN(N)-NNNN; outros países ficam só com +\nconst m = tel.match(/^55(\\d{2})(\\d{4,5})(\\d{4})$/);\nconst telFmt = !tel ? '' : m ? `+55 ${m[1]} ${m[2]}-${m[3]}` : `+${tel}`;\nconst nome = String(h.nomeContato ?? '').trim() || 'sem nome';\nconst resumo = (Array.isArray(h.resumo) ? h.resumo : []).map((l) => String(l ?? '').trim()).filter(Boolean).slice(0, 3);\nconst ultimo = String(h.ultimoTexto ?? '').trim();\nconst linhas = ['Atendimento humano necessário', `Cliente: ${nome}${telFmt ? ' — ' + telFmt : ''}`];\n// link só quando habilitado na CONFIG e houver telefone (chat @lid sem alt não tem)\nif (cfg.INCLUIR_LINK_WA && tel) linhas.push(`Conversa: https://wa.me/${tel}`);\nlinhas.push(`Motivo: ${h.motivo ?? ''}`);\nif (resumo.length) linhas.push('Resumo:', ...resumo.map((l) => `• ${l}`));\nif (ultimo) linhas.push(`Última mensagem: \"${ultimo}\"`);\nlinhas.push(`O bot parou de responder este chat por ${cfg.PAUSA_HORAS}h (renova a cada mensagem da atendente).`);\nreturn [{ json: { texto: linhas.join('\\n') } }];\n"
      },
