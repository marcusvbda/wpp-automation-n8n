    {
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Compute typing delay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Typing delay = clamp(chars / cps, min, max) +/- jitter, rounded to 0.1s.\nconst { config, text } = $input.item.json;\nconst len = String(text ?? '').length;\nconst cps = Number(config.typingCharsPerSecond) || 1;\nconst min = Number(config.typingMinSeconds) || 0;\nconst max = Number(config.typingMaxSeconds) || 0;\nconst jitter = Number(config.typingJitterSeconds) || 0;\nconst base = Math.min(Math.max(len / cps, min), max);\nconst delay = Math.max(0, base + (Math.random() * 2 - 1) * jitter);\nreturn { json: { typingDelaySeconds: Math.round(delay * 10) / 10 } };"
      }
    },
