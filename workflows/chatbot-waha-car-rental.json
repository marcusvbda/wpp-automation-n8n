        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e9000081-0000-4000-8000-000000000081",
              "name": "type",
              "value": "={{ !$json.messageKey ? (!$json.hasMedia && $json.text ? 'text' : 'unknown')\n  : $json.messageKey === 'protocolMessage' ? 'protocol'\n  : ['conversation', 'extendedTextMessage'].includes($json.messageKey) ? ($json.text ? 'text' : 'unknown')\n  : $json.messageKey.startsWith('pollCreationMessage') ? 'poll'\n  : ({ imageMessage: 'image', audioMessage: 'audio', videoMessage: 'video', ptvMessage: 'video',\n      stickerMessage: 'sticker', documentMessage: 'document', documentWithCaptionMessage: 'document',\n      locationMessage: 'location', liveLocationMessage: 'location', contactMessage: 'contact',\n      contactsArrayMessage: 'contact', reactionMessage: 'reaction' })[$json.messageKey] ?? 'unknown' }}",
              "type": "string"
            },
            {
              "id": "e9000082-0000-4000-8000-000000000082",
              "name": "text",
              "value": "={{ $json.text && ($json.messageKey ? ['conversation', 'extendedTextMessage'].includes($json.messageKey) : !$json.hasMedia) ? $json.text : '' }}",
              "type": "string"
            },
            {
              "id": "e9000083-0000-4000-8000-000000000083",
              "name": "isGroup",
              "value": "={{ String($json.chatId ?? '').endsWith('@g.us') }}",
              "type": "boolean"
            },
            {
              "id": "e9000084-0000-4000-8000-000000000084",
              "name": "isDirect",
              "value": "={{ ['@c.us', '@lid', '@s.whatsapp.net'].some(s => String($json.chatId ?? '').endsWith(s)) }}",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "except",
        "excludeFields": "hasMedia, messageKey",
        "options": {}
      }
    },
