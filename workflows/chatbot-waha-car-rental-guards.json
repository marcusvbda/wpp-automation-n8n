    {
      "id": "a1000000-0000-4000-8000-000000000032",
      "name": "Sticky 1 Cheap checks",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -140
      ],
      "parameters": {
        "content": "## 1 · Cheap checks (no writes)\nOwn messages, non-direct chats and the optional allow-list. No DB access happens before the dedupe step.",
        "height": 480,
        "width": 940,
        "color": 7
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000033",
      "name": "Sticky 2 Dedupe",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        930,
        -140
      ],
      "parameters": {
        "content": "## 2 · Dedupe\nInserts the WAHA message id; a conflict means the event was already processed.",
        "height": 480,
        "width": 480,
        "color": 7
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000034",
      "name": "Sticky 3 Rate limit",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1420,
        -140
      ],
      "parameters": {
        "content": "## 3 · Rate limit\nClaims the per-chat reply slot atomically; refused if the last reply is newer than the minimum interval.",
        "height": 480,
        "width": 440,
        "color": 7
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000035",
      "name": "Sticky Contract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -520
      ],
      "parameters": {
        "content": "## Contract\n**Input** `{ config, message }`: config uses `restrictToAllowList`, `allowedChatIds` (comma-separated), `perChatMinIntervalSeconds`; message is the normalized message (`messageId`, `chatId`, `fromMe`, `isDirect`, ...).\n\n**Output** `{ pass, reason }`. Reasons: `from-me` | `not-direct` | `not-allowed` | `duplicate` | `rate-limited` | `ok`.\n\nThe rate-limit slot is claimed atomically on accept and re-stamped after a successful send by the Send sub-workflow.",
        "height": 340,
        "width": 940,
        "color": 7
      }
    }
