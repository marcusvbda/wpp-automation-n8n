      "id": "dd9de74b-36fa-42ba-849d-4d1e31580327",
      "name": "2.1 Extrair mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        896,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza o payload extraído para o formato único usado no restante do fluxo\nconst IGNORAR_CHAVES = ['messageContextInfo', 'senderKeyDistributionMessage'];\nconst POR_CHAVE = { audioMessage: 'audio', imageMessage: 'imagem', videoMessage: 'video', documentMessage: 'documento', documentWithCaptionMessage: 'documento',\n  locationMessage: 'localizacao', liveLocationMessage: 'localizacao', contactMessage: 'contato', contactsArrayMessage: 'contato', stickerMessage: 'figurinha' };\nconst ROTULOS = { audio: 'áudio', imagem: 'imagem', video: 'vídeo', documento: 'documento', localizacao: 'localização', contato: 'contato' };\nconst COM_LEGENDA = ['imagem', 'video', 'documento'];\nconst soDigitos = (jid) => String(jid).split('@')[0].split(':')[0].replace(/\\D/g, '');\nreturn $input.all().map((item) => {\n  const j = item.json;\n  let tipo = 'ignorar';\n  let texto = '';\n  let legendaInterna = '';\n  if (j.temDados) {\n    const c = j.conteudo ?? {};\n    const chave = Object.keys(c).find((k) => !IGNORAR_CHAVES.includes(k)) ?? '';\n    if (chave === 'conversation' || chave === 'extendedTextMessage') {\n      const interno = String(c.conversation ?? c.extendedTextMessage?.text ?? '').trim();\n      if (interno) { tipo = 'texto'; texto = j.corpo || interno; }\n    } else {\n      tipo = POR_CHAVE[chave] ?? 'ignorar';\n      legendaInterna = String(c[chave]?.caption ?? c.documentWithCaptionMessage?.message?.documentMessage?.caption ?? '');\n    }\n  } else if (!j.hasMedia) {\n    if (j.corpo) { tipo = 'texto'; texto = j.corpo; }\n  } else {\n    // sem _data: decide pelo mimetype\n    tipo = j.mimetype.startsWith('audio') ? 'audio' : j.mimetype.startsWith('image') ? 'imagem' : j.mimetype.startsWith('video') ? 'video' : 'documento';\n  }\n  const chatId = String(j.chatId ?? '');\n  const alt = String(j.remoteJidAlt ?? '');\n  const telefone = alt.endsWith('@s.whatsapp.net') ? soDigitos(alt)\n    : (chatId.endsWith('@c.us') || chatId.endsWith('@s.whatsapp.net')) ? soDigitos(chatId) : '';\n  return { json: {\n    idMensagem: j.idMensagem, sessao: j.sessao, fromMe: j.fromMe, source: j.source, chatId,\n    timestamp: j.timestamp, tipo, tipoLabel: ROTULOS[tipo] ?? '', texto,\n    legenda: COM_LEGENDA.includes(tipo) ? (j.corpo || legendaInterna) : '',\n    nomeContato: j.nomeContato, telefone, ehLid: chatId.endsWith('@lid'),\n  } };\n});"
      },
